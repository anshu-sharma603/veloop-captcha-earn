{
  "info": {
    "name": "VELoop CAPTCHA Earn",
    "description": "Run folders in order with the Collection Runner. Requires CAPTCHA_RENDER_MODE=text (default) so `question` is returned and the correct option can be selected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token2",
      "value": ""
    },
    {
      "key": "challengeId",
      "value": ""
    },
    {
      "key": "question",
      "value": ""
    },
    {
      "key": "options",
      "value": "[]"
    },
    {
      "key": "wrongOption",
      "value": ""
    },
    {
      "key": "completedId",
      "value": ""
    },
    {
      "key": "balanceBefore",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (demo user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@veloop.test\",\n  \"password\": \"Demo@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login (second user, for isolation tests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
