                  "pm.test('CORRECT +1', () => { const j = pm.response.json(); pm.expect(j.result).to.eql('CORRECT'); pm.expect(j.reward.amount).to.eql(1); });",
                  "pm.collectionVariables.set('completedId', pm.collectionVariables.get('challengeId'));"
                ]
