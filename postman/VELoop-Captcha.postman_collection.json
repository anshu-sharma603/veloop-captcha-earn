        {
          "name": "Get CAPTCHA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.state === 'RESULT') { pm.collectionVariables.set('challengeId', j.result.challengeId); }",
                  "else { pm.collectionVariables.set('challengeId', j.challenge.challengeId); pm.collectionVariables.set('question', j.challenge.question || ''); pm.collectionVariables.set('options', JSON.stringify(j.challenge.options));",
                  "  pm.test('exactly 4 options', () => pm.expect(j.challenge.options).to.have.lengthOf(4));",
                  "  pm.test('correct answer is not exposed', () => pm.expect(JSON.stringify(j)).to.not.include('correctOption')); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/captcha/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "captcha",
                "current"
              ]
            }
